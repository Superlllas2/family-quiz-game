// Relay for the family quiz: one Durable Object per room (docs/PROTOCOL.md, section 2).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-quiz-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    // The built phone page (npm --prefix ../phone run build). Only /ws/* reaches the Worker first.
    "directory": "../phone/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [
    // The free plan needs SQLite backed Durable Objects (new_classes fails on deploy).
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": { "enabled": true }
}
